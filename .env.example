# ─────────────────────────────────────────────────────────────
# انسخ الملف ده باسم `.env` واملا القيم بتاعتك.
# عمرك ما ترفع الـ .env الحقيقي على جيت — متحطوط في .gitignore لسبب.
# ─────────────────────────────────────────────────────────────

# ١. اعمل بوت: افتح تليجرام، كلّم @BotFather، ابعت /newbot،
#    اعمل اللي هيقولك عليه، والصق التوكن اللي هيديهولك هنا.
TELEGRAM_TOKEN=your_bot_token_here

# ٢. ابعت أي رسالة للبوت الجديد بتاعك، وبعدين افتح اللينك ده في المتصفح:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    دوّر على "chat":{"id":123456789 ...} والصق الرقم ده هنا.
TELEGRAM_CHAT_ID=your_chat_id_here
